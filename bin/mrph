#!/usr/bin/env python3

# A one-line shim over mrph_console.main, kept so that running the command
# straight from a checkout (``venv/bin/python bin/mrph``) works exactly as it
# always did. The installed command comes from the console_scripts entry point
# declared in setup.py, not from this file being copied anywhere.

import sys

from mrph_console import main

sys.exit(main())
